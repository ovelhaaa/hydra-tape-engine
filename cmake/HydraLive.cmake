# Four explicit configurations; production targets retain their own flags.
foreach(pair 00 10 01 11)
  string(SUBSTRING ${pair} 0 1 f4)
  string(SUBSTRING ${pair} 1 1 f5)
  set(defs HYDRA_PHASE72_CLASSIC_FEEDBACK_ROUTING=1 HYDRA_DSP_REFORM_F2_VARIANT=2
    HYDRA_DSP_REFORM_F3_VARIANT=0 HYDRA_DSP_REFORM_F4_TRANSITIONS=${f4}
    HYDRA_DSP_REFORM_F5_TIMING_VARIANT=${f5})
  set(core ${CMAKE_SOURCE_DIR}/dsp/core/tape_core.cpp ${CMAKE_SOURCE_DIR}/dsp/core/hydra_dsp_c_api.cpp)
  foreach(kind trace timing)
    if(kind STREQUAL "trace")
      set(source tests/core/render_trace.cpp)
    else()
      set(source tests/core/f5_timing_test.cpp)
    endif()
    set(target hydra_live_${kind}_${pair})
    add_executable(${target} ${CMAKE_SOURCE_DIR}/${source} ${core})
    target_include_directories(${target} PRIVATE ${CMAKE_SOURCE_DIR}/include ${CMAKE_SOURCE_DIR}/dsp/core)
    target_compile_definitions(${target} PRIVATE ${defs} HYDRA_DSP_TEST_HOOKS=1)
    if(kind STREQUAL "timing")
      add_test(NAME live_timing_${pair} COMMAND ${target})
    endif()
    if(EMSCRIPTEN)
      target_link_options(${target} PRIVATE "SHELL:-sALLOW_MEMORY_GROWTH=1" "SHELL:-sINITIAL_MEMORY=64MB" "SHELL:-sENVIRONMENT=node")
    endif()
  endforeach()
  if(NOT EMSCRIPTEN)
    add_library(hydra_live_${pair} SHARED ${core})
    target_include_directories(hydra_live_${pair} PRIVATE ${CMAKE_SOURCE_DIR}/include ${CMAKE_SOURCE_DIR}/dsp/core)
    target_compile_definitions(hydra_live_${pair} PRIVATE ${defs})
    set_target_properties(hydra_live_${pair} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
  endif()
endforeach()
add_executable(hydra_live_transitions tests/core/f4_transitions_test.cpp ${core})
target_include_directories(hydra_live_transitions PRIVATE ${CMAKE_SOURCE_DIR}/include ${CMAKE_SOURCE_DIR}/dsp/core)
target_compile_definitions(hydra_live_transitions PRIVATE ${defs})
add_test(NAME live_performance_transitions COMMAND hydra_live_transitions)
if(EMSCRIPTEN)
  target_link_options(hydra_live_transitions PRIVATE "SHELL:-sALLOW_MEMORY_GROWTH=1" "SHELL:-sINITIAL_MEMORY=64MB")
endif()
